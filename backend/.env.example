# CodeInsight Backend Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Configuration (DeepSeek API)
# ===========================================
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# ===========================================
# Local Embedding Configuration
# Uses hash-based embedding by default (no API needed)
# Install sentence-transformers for better quality:
#   pip install sentence-transformers
# ===========================================
EMBEDDING_MODEL=local
EMBEDDING_USE_LOCAL=true
EMBEDDING_DIM=384

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=sqlite:///./data/codeinsight.db

# ===========================================
# Data Directories
# ===========================================
DATA_DIR=./data
PROJECTS_DIR=./data/projects
CHROMA_DIR=./data/chroma

# ===========================================
# Chunking Settings
# ===========================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
